# ==============================================================================
# ASTRA Configuration Environment Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the active '.env' file containing actual secrets to source control.
# ==============================================================================

# Application Environment Mode: 'development', 'test', 'production'
ASTRA_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/astra.log
PERFORMANCE_LOGGING=true

# Security & Permission Controls ('STRICT', 'NORMAL', 'PERMISSIVE')
PERMISSIONS_MODE=NORMAL

# Primary API Credentials (Leave blank for offline/mock development)
ASTRA_API_KEY=
VOICE_API_KEY=

# LLM Cognitive Brain Configuration ('gemini' for production, 'mock' for testing)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT=10.0
LLM_RETRY_COUNT=2
LLM_FALLBACK_ENABLED=true

# Hands-Free Wake Word Subsystem ('Hey ASTRA')
WAKE_WORD_ENABLED=true
WAKE_WORD_PHRASE=hey astra
WAKE_WORD_SENSITIVITY=0.6
WAKE_WORD_COMMAND_TIMEOUT=5.0

# Voice Subsystem (STT & TTS)
VOICE_ENABLED=true
STT_PROVIDER=speech_recognition
TTS_PROVIDER=pyttsx3
MICROPHONE_DEVICE=default
LISTEN_TIMEOUT=10.0
SILENCE_TIMEOUT=2.0
MINIMUM_SPEECH_DURATION=0.5
TTS_RATE=175
TTS_VOLUME=1.0
VOICE_LANGUAGE=en-US

# Web Search & Intelligence ('duckduckgo' for production, 'mock' for testing)
WEB_SEARCH_PROVIDER=duckduckgo
MAX_FETCH_SIZE_MB=1.0
MAX_RESEARCH_SOURCES=8
WEB_CACHE_TTL_SEC=3600

# Visual Context & Screen Understanding ('mock' for V2-01 baseline)
VISION_PROVIDER=mock
OCR_PROVIDER=mock
VISION_TIMEOUT=10.0
MAX_IMAGE_SIZE_MB=5.0

# Autonomous Agent Limits
AGENT_MAX_STEPS=20
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=30
AGENT_TIMEOUT=30.0
AGENT_AUTONOMY_LEVEL=LEVEL_3

# Proactive Assistant & Automation
PROACTIVE_ENABLED=true
MAX_AUTOMATIONS=50
MAX_ACTIVE_AUTOMATIONS=20
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=23:00
QUIET_HOURS_END=07:00

# Custom Application Paths (Optional Overrides)
# APP_CALCULATOR=calc.exe
# APP_NOTEPAD=notepad.exe
# APP_CHROME=chrome.exe

