# ASTRA Environment Configuration Example
ASTRA_ENV=development
LOG_LEVEL=INFO
LOG_FILE_PATH=data/logs/astra.log

# Permission configuration (STRICT, NORMAL, PERMISSIVE)
PERMISSIONS_MODE=NORMAL

# Voice Subsystem Configuration (Phase 2)
VOICE_ENABLED=true
STT_PROVIDER=speech_recognition
TTS_PROVIDER=pyttsx3
MICROPHONE_DEVICE=default

LISTEN_TIMEOUT=10.0
SILENCE_TIMEOUT=2.0
MINIMUM_SPEECH_DURATION=0.5

TTS_RATE=175
TTS_VOLUME=1.0
VOICE_LANGUAGE=en-US

# LLM Brain Configuration (Phase 4)
LLM_PROVIDER=mock
LLM_MODEL=mock-astra-v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT=10.0
LLM_FALLBACK_ENABLED=true

# Custom application paths (Optional overrides)
# APP_CALCULATOR=calc.exe
# APP_NOTEPAD=notepad.exe
